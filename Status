local function ClearConnections() 
    for _, Connection in ipairs(CurrentConnections) do 
        if Connection then Connection:Disconnect() end 
    end 
    table.clear(CurrentConnections) 
end 

local function EncontrarAtributo(player, nome)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local obj = leaderstats:FindFirstChild(nome)
        if obj then return obj end
    end
    local objDireto = player:FindFirstChild(nome)
    if objDireto then return objDireto end
    
    for _, sub in ipairs(player:GetChildren()) do
        if sub:IsA("Folder") or sub:IsA("Configuration") then
            local objSub = sub:FindFirstChild(nome)
            if objSub then return objSub end
        end
    end
    return nil
end

local function UpdateSelectedPlayerInfo() 
    ClearConnections() 
    if not SelectedPlayer then return end 
    
    local function RefreshStats() 
        local str = EncontrarAtributo(SelectedPlayer, "Strength")
        local dur = EncontrarAtributo(SelectedPlayer, "Durability")
        local endur = EncontrarAtributo(SelectedPlayer, "Endurance")
        local spd = EncontrarAtributo(SelectedPlayer, "Speed")
        local wins = EncontrarAtributo(SelectedPlayer, "Wins")

        StrengthLabel:Set("Strength: " .. (str and tostring(str.Value) or "N/A")) 
        DurabilityLabel:Set("Durability: " .. (dur and tostring(dur.Value) or "N/A")) 
        EnduranceLabel:Set("Endurance: " .. (endur and tostring(endur.Value) or "N/A")) 
        SpeedLabel:Set("Speed: " .. (spd and tostring(spd.Value) or "N/A")) 
        WinsLabel:Set("Wins: " .. (wins and tostring(wins.Value) or "N/A")) 
    end 
    
    local function RefreshProfile() 
        local belt = EncontrarAtributo(SelectedPlayer, "Belt")
        local skin = EncontrarAtributo(SelectedPlayer, "EquippedSkin") or EncontrarAtributo(SelectedPlayer, "Skin")
        local time = EncontrarAtributo(SelectedPlayer, "Playtime")

        BeltLabel:Set("Belt: " .. (belt and tostring(belt.Value) or "N/A")) 
        SkinLabel:Set("Skin: " .. (skin and tostring(skin.Value) or "N/A")) 
        PlaytimeLabel:Set("Playtime: " .. (time and tostring(time.Value) or "N/A")) 
    end 

    RefreshStats() 
    RefreshProfile() 
    
    local nomesAtributos = {"Strength", "Durability", "Endurance", "Speed", "Wins", "Belt", "EquippedSkin", "Skin", "Playtime"}
    for _, nome in ipairs(nomesAtributos) do
        local obj = EncontrarAtributo(SelectedPlayer, nome)
        if obj and (obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("StringValue")) then
            table.insert( 
                CurrentConnections, 
                obj:GetPropertyChangedSignal("Value"):Connect(function()
                    RefreshStats()
                    RefreshProfile()
                end) 
            ) 
        end
    end
end 

