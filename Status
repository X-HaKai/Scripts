local function ClearConnections()
    local totalConexoes = #getgenv().CurrentConnections
	for i = 1, totalConexoes do
		local Connection = getgenv().CurrentConnections[i]
        if Connection then
            Connection:Disconnect()
        end
	end

	table.clear(getgenv().CurrentConnections)
    
	table.clear(historicosAtributos["Strength"].valores)
	table.clear(historicosAtributos["Durability"].valores)
    historicosAtributos["Strength"].ganho = 0
    historicosAtributos["Durability"].ganho = 0
end

getgenv().UpdateSelectedPlayerInfo = function()
	ClearConnections()

	if not getgenv().SelectedPlayer then return end

	local Alvos = {
		["Strength"] = StrengthLabel,
		["Durability"] = DurabilityLabel,
		["Endurance"] = EnduranceLabel,
		["Speed"] = SpeedLabel,
		["Wins"] = WinsLabel,
		["Belt"] = BeltLabel,
		["EquippedSkin"] = SkinLabel,
		["Playtime"] = PlaytimeLabel
	}

    StrengthLabel:Set("Strength: N/A")
    DurabilityLabel:Set("Durability: N/A")
    EnduranceLabel:Set("Endurance: N/A")
    SpeedLabel:Set("Speed: N/A")
    WinsLabel:Set("Wins: N/A")
    BeltLabel:Set("Belt: N/A")
    SkinLabel:Set("Skin: N/A")
    PlaytimeLabel:Set("Playtime: N/A")

	local function AtualizarTexto(Objeto)
		local Label = Alvos[Objeto.Name]
		if Label then
			if Objeto.Name == "EquippedSkin" then
				Label:Set("Skin: " .. tostring(Objeto.Value))
			elseif Objeto.Name == "Strength" or Objeto.Name == "Durability" then
				local info = historicosAtributos[Objeto.Name]
				if info.ganho > 0 then
					Label:Set(Objeto.Name .. ": " .. tostring(Objeto.Value) .. " (+" .. tostring(info.ganho) .. "/10s)")
				else
					Label:Set(Objeto.Name .. ": " .. tostring(Objeto.Value))
				end
			else
				Label:Set(Objeto.Name .. ": " .. tostring(Objeto.Value))
			end
		end
	end

	local function GerenciarCalculo10Segundos(Objeto)
		if Objeto.Name == "Strength" or Objeto.Name == "Durability" then
			task.spawn(function()
				local info = historicosAtributos[Objeto.Name]
				local valorInicial = tonumber(Objeto.Value) or 0
				
				table.insert(info.valores, { tempo = os.clock(), valor = valorInicial })
				
				task.wait(10)
				
				if not getgenv().SelectedPlayer then return end
				local valorFinal = tonumber(Objeto.Value) or 0
				
				if #info.valores > 0 then
					table.remove(info.valores, 1)
				end
				
				local ganhoCalculado = valorFinal - valorInicial
				if ganhoCalculado >= 0 then
					info.ganho = ganhoCalculado
					AtualizarTexto(Objeto)
				end
			end)
		end
	end

	local function MonitorarObjeto(Objeto)
		if (Objeto:IsA("IntValue") or Objeto:IsA("NumberValue") or Objeto:IsA("StringValue")) and Alvos[Objeto.Name] then
			AtualizarTexto(Objeto)
			GerenciarCalculo10Segundos(Objeto)
			
			local ConexaoMudanca = Objeto:GetPropertyChangedSignal("Value"):Connect(function()
				AtualizarTexto(Objeto)
				GerenciarCalculo10Segundos(Objeto)
			end)
			getgenv().CurrentConnections[#getgenv().CurrentConnections + 1] = ConexaoMudanca
		end
	end

	local todosDescendentes = getgenv().SelectedPlayer:GetDescendants()
	for i = 1, #todosDescendentes do
		MonitorarObjeto(todosDescendentes[i])
	end

	local ConexaoNovosDescendentes = getgenv().SelectedPlayer.DescendantAdded:Connect(function(NovoObjeto)
		task.defer(function()
			if NovoObjeto and NovoObjeto.Parent then
				MonitorarObjeto(NovoObjeto)
			end
		end)
	end)
	getgenv().CurrentConnections[#getgenv().CurrentConnections + 1] = ConexaoNovosDescendentes
end

