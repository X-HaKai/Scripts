    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
 
    if Character and Humanoid and RootPart and THumanoid and TRootPart then
        getgenv().OldPos = RootPart.CFrame
        
        local BV = Instance.new("BodyVelocity")
        BV.Name = "EpixVel"
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(9e8, 9e9, 9e8)
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        local tempoAtaque = tick()
        local velLimite = Vector3.new(9e8, 9e9, 9e8)
        local rotLimite = Vector3.new(9e9, 9e9, 9e9)
        
        repeat
            if TRootPart and RootPart then
                local offsetMovimento = THumanoid.MoveDirection * (THumanoid.WalkSpeed * 0.2)
                local offsetAleatorio = CFrame.new(math.random(-4, 4)/10, math.random(-4, 4)/10, math.random(-4, 4)/10) + offsetMovimento
                local rotacaoAleatoria = CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))
                
                RootPart.CFrame = TRootPart.CFrame * offsetAleatorio * rotacaoAleatoria
