getgenv().SkidFling = function(TargetPlayer)
    if not TargetPlayer or not TargetPlayer.Character then return end
    
    local Character = LocalPlayer.Character
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
    local RootPart = Humanoid and Humanoid.RootPart
    local TCharacter = TargetPlayer.Character
    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
    local TRootPart = THumanoid and THumanoid.RootPart
 
    if Character and Humanoid and RootPart and THumanoid and TRootPart then
        getgenv().OldPos = RootPart.CFrame
        
        local BV = Instance.new("BodyVelocity")
        BV.Name = "EpixVel"
        BV.Parent = RootPart
        BV.Velocity = Vector3.new(9e8, 9e9, 9e8)
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

        local tempoAtaque = tick()
        local velLimite = Vector3.new(9e8, 9e9, 9e8)
        local rotLimite = Vector3.new(9e9, 9e9, 9e9)
        
        repeat
            if TRootPart and RootPart then
                local offsetAleatorio = CFrame.new(math.random(-5, 5)/10, math.random(-5, 5)/10, math.random(-5, 5)/10)
                local rotacaoAleatoria = CFrame.Angles(math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)), math.rad(math.random(-360, 360)))
                
                RootPart.CFrame = TRootPart.CFrame * offsetAleatorio * rotacaoAleatoria
                RootPart.AssemblyLinearVelocity = velLimite
                RootPart.AssemblyAngularVelocity = rotLimite
            end
            task.wait()
        until not TargetPlayer or not TargetPlayer.Character or TRootPart.AssemblyLinearVelocity.Magnitude > 3000 or THumanoid.Health <= 0 or tick() > tempoAtaque + 0.75
        
        BV:Destroy()
        Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
        
        if getgenv().OldPos then
            RootPart.CFrame = getgenv().OldPos
            RootPart.AssemblyLinearVelocity = Vector3.zero
            RootPart.AssemblyAngularVelocity = Vector3.zero
            Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

getgenv().SkidFlingMexendo = function(TargetPlayer)
