getgenv().updateSpin = function(character)
    if not character then return end
    local humanRoot = character:FindFirstChild("HumanoidRootPart")
    if not humanRoot then return end
    
    local filhosRoot = humanRoot:GetChildren()
    for i = 1, #filhosRoot do
        local v = filhosRoot[i]
        if v.Name == "Spinning" then
            v:Destroy()
        end
    end
    
    if _G.AutoSpin then
        local Spin = Instance.new("AngularVelocity")
        Spin.Name = "Spinning"
        Spin.Attachment0 = humanRoot:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", humanRoot)
        Spin.MaxTorque = math.huge
        Spin.AngularVelocity = Vector3.new(0, _G.SpinSpeed or 20, 0)
        Spin.Parent = humanRoot
    end
end

